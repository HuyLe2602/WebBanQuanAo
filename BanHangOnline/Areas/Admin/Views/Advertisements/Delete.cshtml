@model BanHangOnline.Models.EF.Adv

@{
    ViewBag.Title = "Xóa quảng cáo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Xóa quảng cáo</h2>

<h4>Bạn có chắc muốn xóa quảng cáo này?</h4>

<div class="mb-3">
    <p><strong>Tiêu đề:</strong> @Model.Title</p>
    <p><strong>Hình ảnh:</strong></p>
    <img src="@Model.Image" width="150" />
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <button type="submit" class="btn btn-danger">Xóa</button>
    @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-secondary" })
}