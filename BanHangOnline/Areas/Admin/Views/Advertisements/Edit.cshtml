@model BanHangOnline.Models.EF.Adv

@{
    ViewBag.Title = "Sửa quảng cáo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Sửa quảng cáo</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="form-group">
        <label>Tiêu đề</label>
        @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Mô tả</label>
        @Html.TextAreaFor(m => m.Description, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Ảnh</label>
        @Html.TextBoxFor(m => m.Image, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Link</label>
        @Html.TextBoxFor(m => m.Link, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Loại quảng cáo</label>
        @Html.TextBoxFor(m => m.Type, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Cập nhật</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
}