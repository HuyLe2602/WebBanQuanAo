@model IEnumerable<BanHangOnline.Models.EF.News>

@{
ViewBag.Title = "Danh sách bài viết";
Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Danh sách bài viết</h2>

<p>
    @Html.ActionLink("Thêm mới", "Add", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-hover">
    <thead>
    <tr>
        <th>#</th>
        <th>Hình</th>
        <th>Tiêu đề</th>
        <th>Ngày tạo</th>
        <th>Hiển thị</th>
        <th width="180">Thao tác</th>
    </tr>
    </thead>
    <tbody>
    @if (Model != null && Model.Any())
    {
    int i = 1;
    foreach (var item in Model)
    {
    <tr>
        <td>@i</td>
        <td>
            <img src="@item.Image" width="80" />
        </td>
        <td>@item.Title</td>
        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
        <td>@(item.IsActive ? "Hiển thị" : "Ẩn")</td>
        <td>
            @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" })
            @Html.ActionLink("Xoá", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
        </td>
    </tr>
    i++;
    }
    }
    </tbody>
</table>