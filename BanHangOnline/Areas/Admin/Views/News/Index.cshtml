@model IEnumerable<BanHangOnline.Models.EF.News>
@{
    ViewBag.Title = "Danh Sach Tin Tuc";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader {
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang Chu</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/news" class="nav-link">@ViewBag.Title</a>
        </li>
    </ul>
}


<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản lý danh mục</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div>
        </div>
    </div>
</section>


<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Danh sach @ViewBag.Title</h3>

            <div class="card-tools">
                <a href='@Url.Action("Add","News", new { area = "Admin" })' class="btn btn-primary">Thêm mới</a>
                <button id="btnDeleteSelected" class="btn btn-danger">Xóa đã chọn</button>
                <form id="antiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th> STT</th>
                    <th><input type="checkbox" id="chkSelectAll" /></th>
                    <th> Hinh Anh </th>
                    <th> Tieu de tin </th>
                    <th> Ngay Tao </th>
                    <th> Thu tu </th>
                    <th> </th>
                </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr id="trow_@(item.Id)">

                                <td>@i</td>
                                <td><input type="checkbox" class="chkItem" value="@item.Id" /></td>
                                <td>@item.Image</td>
                                <td>@item.Title</td>
                                <td>@(item.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                                <td>
                                    <a href='@Url.Action("Edit","News", new { area = "Admin", id = item.Id })' class="btn btn-sm btn-primary">Sửa</a>
                                    @using (Html.BeginForm("Delete", "News", new { area = "Admin", id = item.Id }, FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</button>
                                    }
                                </td>

                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"></td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>
        <!-- /.card-body -->
        <div class="card-footer">
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @{
                        int current = ViewBag.CurrentPage ?? 1;
                        int total = ViewBag.TotalPages ?? 1;
                        for (int p = 1; p <= total; p++)
                        {
                            <li class="page-item @(p == current ? "active" : "")"><a class="page-link" href="@Url.Action("Index", "News", new { area = "Admin", page = p })">@p</a></li>
                        }
                    }
                </ul>
            </nav>
        </div>
        <!-- /.card-footer-->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->
<!-- /.content-wrapper -->
@section scripts {
    <script>
        $(function () {
            $('#chkSelectAll').on('change', function () {
                $('.chkItem').prop('checked', $(this).prop('checked'));
            });

            $('#btnDeleteSelected').on('click', function () {
                var ids = $('.chkItem:checked').map(function () { return $(this).val(); }).get();
                if (!ids || ids.length === 0) { alert('Chọn ít nhất 1 mục để xóa'); return; }
                if (!confirm('Bạn có chắc muốn xóa các mục đã chọn?')) return;
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '@Url.Action("DeleteMultiple", "News", new { area = "Admin" })',
                    type: 'POST',
                    data: { ids: ids, __RequestVerificationToken: token },
                    traditional: true,
                    success: function () { location.reload(); },
                    error: function (xhr) { alert('Xóa thất bại: ' + xhr.status + ' ' + xhr.statusText); }
                });
            });
        });
    </script>
}
