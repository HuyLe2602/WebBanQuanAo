@model BanHangOnline.Models.EF.News

@{
    ViewBag.Title = "Xoá bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Xoá bài viết</h2>

<div class="alert alert-danger">
    Bạn có chắc muốn xoá bài viết này?
</div>

<div class="form-group">
    <label>Tiêu đề:</label>
    <strong>@Model.Title</strong>
</div>

<div class="form-group">
    <label>Hình ảnh:</label><br />
    <img src="@Model.Image" width="150" />
</div>

@using (Html.BeginForm("Delete", "News", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)

    <button type="submit" class="btn btn-danger">Xác nhận xoá</button>
    @Html.ActionLink("Huỷ", "Index", null, new { @class = "btn btn-secondary" })
}