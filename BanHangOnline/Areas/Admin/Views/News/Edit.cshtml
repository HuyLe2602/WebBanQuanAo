@model BanHangOnline.Models.EF.News

@{
    ViewBag.Title = "Cập nhật bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Cập nhật bài viết</h2>

@using (Html.BeginForm("Edit", "News", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.CreatedDate)

    <div class="form-group">
        <label>Tiêu đề</label>
        @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Title, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <label>Mô tả ngắn</label>
        @Html.TextAreaFor(x => x.Description, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        <label>Nội dung</label>
        @Html.TextAreaFor(x => x.Detail, new { @class = "form-control", @id = "txtDetail" })
    </div>

    <div class="form-group">
        <label>Ảnh đại diện</label>
        @Html.TextBoxFor(x => x.Image, new { @class = "form-control" })
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.IsActive) Hiển thị</label>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.IsHome) Hiện trang chủ</label>
    </div>

    <div class="checkbox">
        <label>@Html.CheckBoxFor(x => x.IsHot) Nổi bật</label>
    </div>

    <div class="form-group">
        <label>Vị trí</label>
        @Html.TextBoxFor(x => x.Position, new { @class = "form-control", type = "number" })
    </div>

    <button type="submit" class="btn btn-success">Cập nhật</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
}