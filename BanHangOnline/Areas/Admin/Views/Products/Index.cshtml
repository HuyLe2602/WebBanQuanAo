@model List<BanHangOnline.Models.EF.Product>
@using System.Linq

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Quản lý sản phẩm</h2>

<p>
    <a href="@Url.Action("Create", "Products", new { area = "Admin" })" class="btn btn-success">
        Thêm mới
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Danh mục</th>
        <th>Giá</th>
        <th>Số lượng</th>
        <th>Hành động</th>
    </tr>
    </thead>

    <tbody>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@Url.Content(item.Image)" width="80" />
                    }
                </td>
                <td>@item.Title</td>
                <td>@(item.ProductCategory != null ? item.ProductCategory.Title : "")</td>
                <td>@String.Format("{0:N0}", item.Price) đ</td>
                <td>@item.Quantity</td>
                <td>
                    <a href="@Url.Action("Edit", "Products", new { area = "Admin", id = item.Id })"
                       class="btn btn-primary btn-sm">Sửa</a>

                    <a href="@Url.Action("Delete", "Products", new { area = "Admin", id = item.Id })"
                       class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="text-center">Không có dữ liệu</td>
        </tr>
    }
    </tbody>
</table>