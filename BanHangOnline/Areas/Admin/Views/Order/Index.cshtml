@model IEnumerable<BanHangOnline.Models.EF.Order>

@{
    ViewBag.Title = "Quản lý Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Danh sách Đơn Hàng</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Admin</a></li>
                    <li class="breadcrumb-item active">Đơn Hàng</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <!-- Thông báo -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        }

        <!-- Bảng danh sách -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Tất cả Đơn Hàng</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 10px">#</th>
                            <th>Mã Đơn</th>
                            <th>Tên Khách Hàng</th>
                            <th>Điện Thoại</th>
                            <th>Tổng Tiền</th>
                            <th>Số Lượng</th>
                            <th>Ngày Tạo</th>
                            <th style="width: 150px">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count() > 0)
                        {
                            int stt = 1;
                            foreach (var order in Model)
                            {
                                <tr>
                                    <td>@stt</td>
                                    <td><strong>@order.Code</strong></td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.Phone</td>
                                    <td class="text-right">
                                        <span class="badge badge-info">@order.TotalAmount.ToString("N0") đ</span>
                                    </td>
                                    <td class="text-center">@order.Quantity</td>
                                    <td>@order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = order.Id })" class="btn btn-info btn-sm" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i> Xem
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = order.Id })" class="btn btn-warning btn-sm" title="Sửa">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = order.Id })" class="btn btn-danger btn-sm" title="Xóa">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    Không có đơn hàng nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <small class="text-muted">Tổng cộng: <strong>@(Model != null ? Model.Count() : 0)</strong> đơn hàng</small>
            </div>
        </div>
        <!-- /.card -->
    </div>
</section>
<!-- /.content -->
