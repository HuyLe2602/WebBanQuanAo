
@model IEnumerable<BanHangOnline.Models.EF.Product>
@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Danh sách sản phẩm</h3>
            <div class="card-tools">
                <a href='@Url.Action("Add","Product", new { area = "Admin" })' class="btn btn-primary">Thêm mới</a>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Giá KM</th>
                        <th>Số lượng</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@(item.Title ?? item.TenSanPham)</td>
                                <td>@item.Price</td>
                                <td>@item.PriceSale</td>
                                <td>@item.Quantity</td>
                                <td>
                                    <a href='@Url.Action("Edit","Product", new { area = "Admin", id = item.Id })' class="btn btn-sm btn-primary">Sửa</a>
                                    @using (Html.BeginForm("Delete","Product", new { area = "Admin", id = item.Id }, FormMethod.Post, new { @style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</button>
                                    }
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="6">Không có sản phẩm</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

