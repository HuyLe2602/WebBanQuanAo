@model BanHangOnline.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký";
}

<link href="~/Content/assets/plugins/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" />

<div class="container" style="margin-top:180px; margin-bottom:80px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div style="background:#fff; padding:40px; border-radius:10px; box-shadow:0 10px 30px rgba(0,0,0,.08);">

                <div class="text-center mb-4">
                    <h2 style="font-weight:700;">Tạo tài khoản</h2>
                    <p style="color:#777;">Đăng ký để mua sắm nhanh hơn</p>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "register-form", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="text-danger mb-3">
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                    </div>

                    <div class="form-group mb-3">
                        <label>Email</label>
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập email",
                            style = "height:50px;border-radius:8px;"
                        })
                    </div>

                    <div class="form-group mb-3">
                        <label>Mật khẩu</label>
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập mật khẩu",
                            style = "height:50px;border-radius:8px;"
                        })
                    </div>

                    <div class="form-group mb-4">
                        <label>Xác nhận mật khẩu</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new
                        {
                            @class = "form-control",
                            placeholder = "Nhập lại mật khẩu",
                            style = "height:50px;border-radius:8px;"
                        })
                    </div>

                    <button type="submit"
                            class="btn btn-block"
                            style="width:100%; height:50px; background:#fe4c50; color:#fff; border:none; border-radius:8px; font-weight:600;">
                        Đăng ký
                    </button>

                    <div class="text-center mt-4">
                        <span style="color:#777;">Đã có tài khoản?</span>
                        <a href="@Url.Action("Login", "Account")" style="color:#fe4c50; font-weight:600;">
                            Đăng nhập
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}