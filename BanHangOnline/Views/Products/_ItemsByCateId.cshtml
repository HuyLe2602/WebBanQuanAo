@model IEnumerable<BanHangOnline.Models.EF.Product>

@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var strImage = item.Image;

        <div class="product-item @item.ProductCategory.Alias ">
            <div class="product discount product_filter">
                <div class="product_image">
                    <img src="@strImage" alt="@item.Title" />
                </div>
                <div class="favorite favorite_left"></div>
                <div class="product_bubble product_bubble_right product_bubble_red d-flex flex-column align-items-center"><span>-@(item.Price - item.PriceSale)</span></div>
                <div class="product_info">
                    <h6 class="product_name"><a href="/Products/Detail/@item.Id">@item.Title</a></h6>
                    @if (item.PriceSale > 0)
                    {
                        <div class="product_price">
                            <span style="text-decoration: line-through;">@item.Price VND</span>
                            <span style="color: red; font-weight: bold;">@item.PriceSale VND</span>
                        </div>
                    }
                    else
                    {
                        <div class="product_price">@item.Price VND</div>
                    }
                </div>
            </div>
            <div class="red_button add_to_cart_button">
                <form action="/Cart/AddToCart" method="post" style="display: inline;">
                    <input type="hidden" name="productId" value="@item.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" style="background: none; border: none; color: inherit; cursor: pointer; text-decoration: none;">Thêm vào giỏ</button>
                </form>
            </div>
        </div>
    }
}
