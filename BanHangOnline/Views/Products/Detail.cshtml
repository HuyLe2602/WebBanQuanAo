@model BanHangOnline.Models.EF.Product

@{
    ViewBag.Title = Model.Title;
}

<div class="container mt-5">
    <div class="row">

        <!-- IMAGE -->
        <div class="col-md-5">
            <img src="@Model.Image" class="img-fluid" />
        </div>

        <!-- INFO -->
        <div class="col-md-7">
            <h3>@Model.Title</h3>

            <h4 style="color:red;">
                @(Model.PriceSale > 0 ? Model.PriceSale.ToString("N0") : Model.Price.ToString("N0")) đ
            </h4>

            @if (Model.PriceSale > 0)
            {
                <span style="text-decoration: line-through;">
                    @Model.Price.ToString("N0") đ
                </span>
            }

            <hr />

            <!-- SIZE -->
            <div class="form-group">
                <label>Size:</label><br />
                <select id="size" class="form-control" style="width:120px;">
                    <option value="S">S</option>
                    <option value="M">M</option>
                    <option value="L">L</option>
                    <option value="XL">XL</option>
                </select>
            </div>

            <!-- QUANTITY -->
            <div class="form-group mt-3">
                <label>Số lượng:</label>
                <input type="number" id="quantity" value="1" min="1" class="form-control" style="width:120px;" />
            </div>

            <!-- ADD TO CART -->
            <div class="mt-4">
                @Html.AntiForgeryToken()

                <input type="hidden" id="productId" value="@Model.Id" />

                <button type="button" id="btnAddToCart" class="btn btn-danger">
                    Thêm vào giỏ
                </button>
            </div>

            <hr />

            <p>@Model.Description</p>
        </div>

    </div>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $("#btnAddToCart").click(function () {

        var productId = $("#productId").val();
        var quantity = $("#quantity").val();
        var size = $("#size").val();
        var token = $('input[name="__RequestVerificationToken"]').val();

        $.ajax({
            url: '/Cart/AddToCart',
            type: 'POST',
            data: {
                __RequestVerificationToken: token,
                productId: productId,
                quantity: quantity,
                size: size
            },
            success: function (res) {
                if (res.success) {
                    alert("✅ Đã thêm vào giỏ hàng!");

                    // cập nhật số lượng giỏ hàng nếu có
                    $("#cart-count").text(res.count);
                } else {
                    alert(res.message);
                }
            },
            error: function () {
                alert("❌ Có lỗi xảy ra!");
            }
        });

    });
</script>