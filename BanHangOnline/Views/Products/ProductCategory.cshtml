@model IEnumerable<BanHangOnline.Models.EF.Product>

@{
    var category = ViewBag.Category as BanHangOnline.Models.EF.ProductCategory;
}

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">@category.Title</h2>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 text-center">
                        <img src="@item.Image" class="card-img-top" style="height:260px; object-fit:cover;" />
                        <div class="card-body">
                            <h5>@item.Title</h5>
                            <p>@item.Price.ToString("N0") đ</p>
                            <a href="/chi-tiet/@item.Alias-p@(item.Id)" class="btn btn-dark">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p>Chưa có sản phẩm trong danh mục này.</p>
            </div>
        }
    </div>
</div>  