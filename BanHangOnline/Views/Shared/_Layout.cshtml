@using BanHangOnline.Models.EF
@using System.Linq

<!DOCTYPE html>
<html>
<head>
    <title>Colo Shop</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- CSS -->
    <link rel="stylesheet" href="~/Content/assets/styles/bootstrap4/bootstrap.min.css">
    <link rel="stylesheet" href="~/Content/assets/plugins/font-awesome-4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/Content/assets/styles/main_styles.css">
    <link rel="stylesheet" href="~/Content/assets/styles/responsive.css">

    @Styles.Render("~/Content/css")

    <style>
        /* ✅ FIX HEADER nhưng KHÔNG phá layout */
        .header {
            position: relative; /* đổi từ fixed -> relative */
            width: 100%;
            z-index: 999;
            background: #fff;
        }

        /* badge cart */
        .checkout_items {
            background: red;
            color: #fff;
            border-radius: 50%;
            padding: 2px 6px;
            font-size: 12px;
            position: absolute;
            top: -8px;
            right: -10px;
        }

        .cart-icon {
            position: relative;
            display: inline-block;
        }
    </style>
</head>

<body>

@{
    var cart = Session["Cart"] as List<CartItem>;
    var cartCount = cart != null ? cart.Sum(x => x.Quantity) : 0;
}

<div class="super_container">

    <!-- HEADER -->
    <header class="header trans_300">

        <!-- TOP NAV -->
        <div class="top_nav">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <div class="top_nav_left">Free shipping on all orders</div>
                    </div>

                    <div class="col-md-6 text-right">
                        <div class="top_nav_right">
                            <ul class="top_nav_menu">
                                <li class="account">
                                    <a href="#">
                                        Tài khoản
                                        <i class="fa fa-angle-down"></i>
                                    </a>
                                    @Html.Partial("_LoginPartial")
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MAIN NAV -->
        <div class="main_nav_container">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-right">

                        <!-- LOGO -->
                        <div class="logo_container">
                            <a href="/">colo<span>shop</span></a>
                        </div>

                        <!-- MENU -->
                        <nav class="navbar">
                            @Html.Action("MenuTop", "Menu")

                            <ul class="navbar_user">

                                <!-- SEARCH -->
                                <li>
                                    <a href="#"><i class="fa fa-search"></i></a>
                                </li>

                                <!-- USER -->
                                <li>
                                    @if (Request.IsAuthenticated)
                                    {
                                        <a href="@Url.Action("Profile", "Account")">
                                            <i class="fa fa-user"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Login", "Account")">
                                            <i class="fa fa-user"></i>
                                        </a>
                                    }
                                </li>

                                <!-- CART -->
                                <li class="checkout">
                                    <a href="@Url.Action("Index","Cart")" class="cart-icon">
                                        <i class="fa fa-shopping-cart"></i>
                                        <span id="cart-count" class="checkout_items">@cartCount</span>
                                    </a>
                                </li>

                            </ul>

                            <div class="hamburger_container">
                                <i class="fa fa-bars"></i>
                            </div>
                        </nav>

                    </div>
                </div>
            </div>
        </div>

    </header>

    <!-- BODY -->
    @RenderBody()

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container text-center">
            <p>© Colo Shop - ASP.NET MVC</p>
        </div>
    </footer>

</div>

<!-- SCRIPTS -->
<script src="~/Content/assets/js/jquery-3.2.1.min.js"></script>
<script src="~/Content/assets/styles/bootstrap4/popper.js"></script>
<script src="~/Content/assets/styles/bootstrap4/bootstrap.min.js"></script>
<script src="~/Content/assets/plugins/Isotope/isotope.pkgd.min.js"></script>
<script src="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.carousel.js"></script>
<script src="~/Content/assets/plugins/easing/easing.js"></script>
<script src="~/Content/assets/js/custom.js"></script>

<!-- AJAX CART -->
<script>
    function updateCartCount() {
        $.get('/Cart/GetCartCount', function (res) {
            $("#cart-count").text(res);
        });
    }

    $(document).ready(function () {
        updateCartCount();
    });
</script>

@RenderSection("scripts", required: false)

</body>
</html>