@model IEnumerable<BanHangOnline.Models.EF.News>

@if (Model != null && Model.Any())
{
    <div class="latest_blog">
        <div class="container">
            <div class="row">
                <div class="col text-center">
                    <div class="section_title new_arrivals_title">
                        <h2>Tin tức mới nhất</h2>
                    </div>
                </div>
            </div>

            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-lg-4 blog_item_col">
                        <div class="blog_item">
                            <div class="blog_background"
                                 style="background-image:url('@item.Image'); height:250px; background-size:cover; background-position:center;">
                            </div>
                            <div class="blog_content d-flex flex-column align-items-center justify-content-center text-center">
                                <h4>@item.Title</h4>
                                <span>@item.CreatedDate.ToString("dd/MM/yyyy")</span>
                                <a class="blog_more" href="/tin-tuc/@item.Alias-n@(item.Id)">Xem thêm</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}