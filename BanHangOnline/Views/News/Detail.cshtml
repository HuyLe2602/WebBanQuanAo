@model BanHangOnline.Models.EF.News

@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h1>@Model.Title</h1>
            <p class="text-muted">
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
            </p>

            <div class="mb-3">
                <img src="@Model.Image" alt="@Model.Title" class="img-fluid" style="width:100%; max-height:500px; object-fit:cover;" />
            </div>

            <div class="news-detail-content">
                @Html.Raw(Model.Detail)
            </div>
        </div>
    </div>
</div> 