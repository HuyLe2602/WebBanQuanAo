@model List<BanHangOnline.Models.EF.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2>Giỏ hàng của bạn</h2>
    
    @if (Model == null || Model.Count == 0)
    {
        <p>Giỏ hàng trống. <a href="/Products/Index">Tiếp tục mua sắm</a></p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Số lượng</th>
                    <th>Tổng tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.Product.Image" alt="@item.Product.Title" style="width: 50px;" /></td>
                        <td>@item.Product.Title</td>
                        <td>@item.Price VND</td>
                        <td>
                            <form action="/Cart/Update" method="post" style="display: inline;">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" style="width: 60px;" />
                                <button type="submit" class="btn btn-sm btn-success">Cập nhật</button>
                            </form>
                        </td>
                        <td>@item.Total VND</td>
                        <td><a href="/Cart/Remove/@item.ProductId" class="btn btn-sm btn-danger">Xóa</a></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="row mt-4">
            <div class="col-md-6"></div>
            <div class="col-md-6">
                <h4>Tổng tiền giỏ hàng: <strong>@Model.Sum(x => x.Total) VND</strong></h4>
                <a href="/Cart/Checkout" class="btn btn-primary btn-lg">Tiến hành thanh toán</a>
                <a href="/Products/Index" class="btn btn-secondary btn-lg">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
</div>
