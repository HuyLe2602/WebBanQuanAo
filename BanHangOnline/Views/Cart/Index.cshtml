@model List<BanHangOnline.Models.EF.CartItem>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <h2 class="mb-4">🛒 Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Giỏ hàng trống.
            <a href="@Url.Action("Index","Home")">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead class="thead-dark">
                    <tr>
                        <th>Ảnh</th>
                        <th>Sản phẩm</th>
                        <th>Size</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Tổng</th>
                        <th>Xóa</th>
                    </tr>
                </thead>

                <tbody id="cart-body">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><img src="@item.Image" style="width:60px;" /></td>
                            <td>@item.ProductName</td>
                            <td>@item.Size</td>
                            <td>@item.Price.ToString("N0") đ</td>

                            <td>
                                <input type="number" class="form-control qty"
                                       data-id="@item.ProductId"
                                       data-size="@item.Size"
                                       value="@item.Quantity" min="1"
                                       style="width:80px;margin:auto;" />
                            </td>

                            <td>@(item.Price * item.Quantity).ToString("N0") đ</td>

                            <td>
                                <button class="btn btn-danger btn-sm remove"
                                        data-id="@item.ProductId"
                                        data-size="@item.Size">
                                    X
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-right mt-4">
            <h4 class="text-danger">
                Tổng tiền: <span id="total">
                    @Model.Sum(x => x.Price * x.Quantity).ToString("N0")
                </span> đ
            </h4>

            <a href="@Url.Action("Checkout","Cart")"
               class="btn btn-success btn-lg mt-2">
                Thanh toán
            </a>
        </div>
    }
</div>

@section scripts{
<script>
    // UPDATE QUANTITY
    $(".qty").change(function () {
        var id = $(this).data("id");
        var size = $(this).data("size");
        var qty = $(this).val();

        $.post('/Cart/Update', {
            productId: id,
            size: size,
            quantity: qty
        }, function () {
            location.reload();
        });
    });

    // REMOVE
    $(".remove").click(function () {
        var id = $(this).data("id");
        var size = $(this).data("size");

        $.get('/Cart/Remove', {
            productId: id,
            size: size
        }, function () {
            location.reload();
        });
    });
</script>
}