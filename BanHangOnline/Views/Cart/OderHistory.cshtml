@model List<BanHangOnline.Models.EF.Order>

@{
    ViewBag.Title = "Lịch sử đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2>Lịch sử đơn hàng</h2>

    @if (Model == null || Model.Count == 0)
    {
        <p>Bạn chưa có đơn hàng nào. <a href="/Products/Index">Mua hàng ngay</a></p>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Ngày đặt</th>
                    <th>Số lượng</th>
                    <th>Tổng tiền</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Code</td>
                        <td>@order.CustomerName</td>
                        <td>@order.Phone</td>
                        <td>@order.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@order.Quantity</td>
                        <td>@order.TotalAmount VND</td>
                        <td>
                            <a href="/Cart/OrderDetail/@order.Id" class="btn btn-sm btn-info">Xem chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-4">
        <a href="/Products/Index" class="btn btn-primary">Tiếp tục mua sắm</a>
    </div>
</div>
