@model IEnumerable<BanHangOnline.Models.EF.Category>

<ul class="navbar_menu">
    <li>
        <a href="/trang-chu">Trang chủ</a>
    </li>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <li>
                <a href="/@item.Alias">
                    @item.Title
                </a>
            </li>
        }
    }

    <li>
        <a href="/tin-tuc">Tin tức</a>
    </li>
</ul>