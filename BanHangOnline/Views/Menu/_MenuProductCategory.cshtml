@model IEnumerable<BanHangOnline.Models.EF.ProductCategory>

@if (Model != null && Model.Any())
{
    <div class="banner">
        <div class="container">
            <div class="row">
                @foreach (var item in Model)
                {
                    var image = !string.IsNullOrEmpty(item.Icon)
                        ? item.Icon
                        : "/Content/assets/images/banner_1.jpg";

                    <div class="col-md-4">
                        <div class="banner_item align-items-center" style="background-image:url('@image')">
                            <div class="banner_category">
                                <a href="@Url.Action("ProductCategory", "Products", new { alias = item.Alias, id = item.Id })">
                                    @item.Title
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}