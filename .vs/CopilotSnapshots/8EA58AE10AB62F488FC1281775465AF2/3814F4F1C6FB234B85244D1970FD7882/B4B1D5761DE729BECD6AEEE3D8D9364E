@model IEnumerable<BanHangOnline.Models.EF.Product>

@{
    ViewBag.Title = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/products" class="nav-link">@ViewBag.Title</a>
        </li>
    </ul>
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Quản lý sản phẩm</h1>
    </div>
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title</h3>
            <div class="card-tools">
                <a href="/admin/products/add" class="btn btn-primary">Thêm mới</a>
                <a href="#" class="btn btn-danger" id="BtnDeleteAll">Xóa</a>
            </div>
        </div>

        <div class="card-body">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Ảnh</th>
                        <th>Tên</th>
                        <th>Danh mục</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Ngày</th>
                        <th>Home</th>
                        <th>Hiển thị</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var item in Model)
                        {
                            var img = item.ProductImage?.FirstOrDefault(x => x.IsDefault)?.Image;
                            var imagePath = string.IsNullOrEmpty(img) ? "/Content/images/no-image.jpg" : img;

                            <tr id="row_@item.Id">
                                <td><input type="checkbox" class="cbkItem" value="@item.Id" /></td>
                                <td>@i</td>
                                <td><img src="@imagePath" width="50" /></td>
                                <td>@item.Title</td>
                                <td>@(item.ProductCategory?.Title ?? "")</td>
                                <td>@item.Quantity</td>
                                <td>@BanHangOnline.Common.Common.FormatNumber(item.Price, 0)</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>

                                <td class="text-center">
                                    <a href="#" class="btnHome" data-id="@item.Id">
                                        @(item.IsHome
                                    ? Html.Raw("<i class='fas fa-check text-success'></i>")
                                    : Html.Raw("<i class='fas fa-times text-danger'></i>"))
                                    </a>
                                </td>

                                <td class="text-center">
                                    <a href="#" class="btnActive" data-id="@item.Id">
                                        @(item.IsActive
                                    ? Html.Raw("<i class='fas fa-check text-success'></i>")
                                    : Html.Raw("<i class='fas fa-times text-danger'></i>"))
                                    </a>
                                </td>

                                <td>
                                    <a href="/admin/products/edit/@item.Id" class="btn btn-sm btn-primary">Sửa</a>
                                    <a href="#" data-id="@item.Id" class="btn btn-sm btn-danger btnDelete">Xóa</a>
                                </td>
                            </tr>

                            i++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {

        // SELECT ALL
        $('#SelectAll').change(function () {
            $('.cbkItem').prop('checked', this.checked);
        });

        // DELETE 1
        $('body').on('click', '.btnDelete', function () {
            var id = $(this).data('id');

            if (!confirm("Bạn có chắc muốn xóa?")) return;

            $.post('/admin/Products/Delete', { id: id }, function (rs) {
                if (rs.success) {
                    $('#row_' + id).remove();
                } else {
                    alert("Xóa thất bại!");
                }
            });
        });

        // DELETE ALL
        $('#BtnDeleteAll').click(function (e) {
            e.preventDefault();

            var ids = [];
            $('.cbkItem:checked').each(function () {
                ids.push($(this).val());
            });

            if (ids.length === 0) {
                alert("Chọn ít nhất 1 sản phẩm!");
                return;
            }

            $.post('/admin/Products/DeleteAll', { ids: ids.join(',') }, function (rs) {
                if (rs.success) {
                    location.reload();
                } else {
                    alert("Lỗi!");
                }
            });
        });

        // ACTIVE
        $('body').on('click', '.btnActive', function (e) {
            e.preventDefault();
            var btn = $(this);
            var id = btn.data('id');

            $.post('/admin/Products/ChangeActive', { id: id }, function (rs) {
                if (rs.success) {
                    if (rs.isActive) {
                        btn.html("<i class='fas fa-check text-success'></i>");
                    } else {
                        btn.html("<i class='fas fa-times text-danger'></i>");
                    }
                }
            });
        });

        // HOME
        $('body').on('click', '.btnHome', function (e) {
            e.preventDefault();
            var btn = $(this);
            var id = btn.data('id');

            $.post('/admin/Products/IsHome', { id: id }, function (rs) {
                if (rs.success) {
                    if (rs.isHome) {
                        btn.html("<i class='fas fa-check text-success'></i>");
                    } else {
                        btn.html("<i class='fas fa-times text-danger'></i>");
                    }
                }
            });
        });

    });
</script>